<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>USDT DZ</title>

<style>
* {
box-sizing: border-box;
margin: 0;
padding: 0;
font-family: Arial, sans-serif;
}

body {
background: #f5f7fa;
color: #222;
}

header {
background: #111827;
color: white;
padding: 20px;
text-align: center;
}

header h1 {
font-size: 28px;
margin-bottom: 8px;
}

header p {
color: #cbd5e1;
}

.container {
max-width: 500px;
margin: 40px auto;
padding: 20px;
}

.card {
background: white;
padding: 25px;
border-radius: 18px;
box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

h2 {
margin-bottom: 20px;
text-align: center;
}

label {
display: block;
margin: 12px 0 7px;
font-weight: bold;
}

input, select {
width: 100%;
padding: 14px;
border: 1px solid #ddd;
border-radius: 10px;
font-size: 16px;
}

.result {
margin-top: 20px;
padding: 15px;
background: #f1f5f9;
border-radius: 10px;
text-align: center;
font-size: 20px;
font-weight: bold;
}

button {
width: 100%;
margin-top: 20px;
padding: 15px;
border: none;
border-radius: 10px;
background: #16a34a;
color: white;
font-size: 18px;
font-weight: bold;
cursor: pointer;
}

button:hover {
opacity: 0.9;
}

footer {
text-align: center;
margin-top: 30px;
color: #777;
font-size: 14px;
}
</style>
</head>

<body>

<header>
<h1>USDT DZ</h1>
<p>شراء USDT بطريقة سهلة وسريعة</p>
</header>

<div class="container">

<div class="card">

<h2>شراء USDT</h2>

<label>المبلغ بالدينار الجزائري</label>
<input
type="number"
id="amount"
placeholder="مثال: 50000"
oninput="calculate()"
>

<label>سعر 1 USDT بالدينار</label>
<input
type="number"
id="price"
value="250"
oninput="calculate()"
>

<div class="result">
تحصل على: <span id="usdt">0</span> USDT
</div>

<label>طريقة الدفع</label>

<select id="payment">
<option>CCP / BaridiMob</option>
<option>تحويل بنكي</option>
<option>الدفع اليدوي</option>
</select>

<button onclick="order()">
اطلب شراء USDT
</button>

</div>

<footer>
© 2026 USDT DZ
</footer>

</div>

<script>
function calculate() {
const amount = Number(document.getElementById("amount").value);
const price = Number(document.getElementById("price").value);

if (amount > 0 && price > 0) {
document.getElementById("usdt").innerText =
(amount / price).toFixed(2);
} else {
document.getElementById("usdt").innerText = "0";
}
}

function order() {
const amount = document.getElementById("amount").value;

if (!amount || amount <= 0) {
alert("أدخل المبلغ أولاً");
return;
}

alert("تم تسجيل طلبك بنجاح");
}
</script>

</body>
</html>
